<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ f.name }} — {{ scope.program }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
         color: #1a1a1a; line-height: 1.55; max-width: 820px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.5rem; border-bottom: 3px solid #c0392b; padding-bottom: .4rem; }
  h2 { font-size: 1.15rem; margin-top: 1.8rem; color: #222; border-bottom: 1px solid #ddd; padding-bottom: .2rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .92rem; }
  th, td { text-align: left; padding: .45rem .6rem; border: 1px solid #ddd; }
  th { background: #f6f6f6; width: 32%; }
  code, pre { background: #f4f4f4; border-radius: 4px; }
  code { padding: .1rem .3rem; }
  pre { padding: .8rem; overflow-x: auto; border: 1px solid #e3e3e3; white-space: pre-wrap; word-break: break-word; }
  .sev { display: inline-block; padding: .15rem .55rem; border-radius: 4px; color: #fff; font-weight: 600; }
  .Critical { background: #7b241c; } .High { background: #c0392b; }
  .Medium { background: #d68910; } .Low { background: #2e86c1; } .Informational { background: #7f8c8d; }
  footer { margin-top: 2.5rem; font-size: .78rem; color: #777; border-top: 1px solid #eee; padding-top: .8rem; }
</style>
</head>
<body>
<h1>{{ f.name }}</h1>
<table>
  <tr><th>Programa</th><td>{{ scope.program }} ({{ scope.platform }})</td></tr>
  <tr><th>Severidad</th><td><span class="sev {{ f.severity }}">{{ f.severity }}</span></td></tr>
  <tr><th>CVSS v3.1</th><td>{{ "%.1f"|format(f.cvss_score or 0) }} — <code>{{ f.cvss_vector }}</code></td></tr>
  <tr><th>Tier (VRT)</th><td>{{ f.vrt_tier }}{% if tier_info %} — {{ tier_info.name }} (orientativo {{ tier_info.typical_bounty_usd }} USD){% endif %}</td></tr>
  <tr><th>Clase</th><td>{{ kb.display }} — {{ kb.cwe }} / {{ kb.owasp }}</td></tr>
  <tr><th>Activo afectado</th><td><code>{{ f.url }}</code></td></tr>
  {% if f.param %}<tr><th>Parámetro</th><td><code>{{ f.param }}</code></td></tr>{% endif %}
  <tr><th>Fecha</th><td>{{ now }}</td></tr>
</table>

<h2>Resumen</h2>
<p>{{ f.explanation | nl2br }}</p>

<h2>Pasos para reproducir</h2>
<pre>{{ f.reproduction }}</pre>

<h2>Prueba de concepto (evidencia)</h2>
{% if evidence.payload %}<p><strong>Payload:</strong> <code>{{ evidence.payload }}</code></p>{% endif %}
{% if evidence.request %}<p><strong>Petición:</strong></p><pre>{{ evidence.request }}</pre>{% endif %}
{% if evidence.response %}<p><strong>Respuesta (fragmento):</strong></p><pre>{{ evidence.response }}</pre>{% endif %}
{% if evidence.extracted %}<p><strong>Datos extraídos:</strong> {{ evidence.extracted }}</p>{% endif %}
<p><em>Adjunta aquí las capturas de pantalla que demuestren la ejecución/acceso.</em></p>

<h2>Impacto</h2>
<p>{{ f.impact | nl2br }}</p>

<h2>Remediación</h2>
<p>{{ f.remediation | nl2br }}</p>

<h2>Referencias</h2>
<ul>{% for ref in refs %}<li>{{ ref }}</li>{% endfor %}</ul>

<footer>
Informe generado por BBHunter. Contenido redactado por: {{ llm_source }}.
Debe revisarse y validarse manualmente antes de su envío. Probar solo dentro del scope autorizado.
</footer>
</body>
</html>
